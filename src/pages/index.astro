---
import Buttons from "../components/Buttons.astro"
import GitHubContributions from "../components/GitHubContributions"
import NowPlaying from "../components/NowPlaying"
import Layout from "../layouts/Layout.astro"
import Footer from "../components/Footer.astro";

---

<Layout title="Главная">
<div class="flex min-h-[calc(100dvh-5.5rem)] flex-col justify-center gap-4">
<div class="container flex flex-col w-full mx-auto gap-4 min-w-0">

<div class="min-w-0">
<p><img src="me.jpg" width="88" height="88" alt="That's me" class="rounded-2xl rotate-2 focus:rotate-0 hover:rotate-0 transition"></p>
<div class="mt-3 sm:mt-4">
<h1 class="text-[clamp(1.35rem,1rem+1.5vw,1.75rem)] font-bold">Моя звать Леонид.</h1>
<p>Студентота, инжир-погромист, шитпостер.</p>
<p>Где-то меня можно найти, например: на <a href="https://github.com/Lennichijou" target="_blank" class=""><i class="si-fit si-github"></i> GitHub</a> или в <a href="https://t.me/Lenhardt" target="_blank" class="">
  <i class="si-fit si-telegram"></i> Telegram</a>.</p>

</div>
</div>
<div class="min-w-0">
<GitHubContributions client:idle />
</div>
<div class="min-w-0">
<NowPlaying client:load />
</div>
</div>
<div class="min-w-0">
<Buttons />
</div>
<div class="min-w-0">
<Footer />
</div>
</div>
</Layout>
