---
import pkg from '../../package.json' with { type: 'json' };
const projectVersion: string = pkg.version || 'unknown';
const astroVersion: string = pkg.dependencies?.["astro"] || 'unknown';
const tailwindVersion: string = pkg.devDependencies?.["@tailwindcss/vite"] || 'unknown';

import CurrentYear from './Year'
---
<div class="opacity-75 text-sm">
    <p>Электропочта: <code>hello [собачка] lenny [точка] wtf</code>.</p>
    <p>Копирайт гыгыгы <CurrentYear />.</p>
    <p>Версия сайта v{projectVersion} ({import.meta.env.BUILD_TIME}).</p>
    <p>
        Made with <a href="https://astro.build/" target="_blank" class="">
            <i class="devicon-astro-plain"></i> Astro <small>{astroVersion.slice(1)}</small>
        </a> + <a href="https://tailwindcss.com" target="_blank" class="">
            <i class="devicon-tailwindcss-plain"></i> Tailwind <small>{tailwindVersion.slice(1)}</small>
        </a>.
    </p>
</div>